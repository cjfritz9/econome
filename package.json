{
  "name": "econome-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "node --env-file=.env --import tsx src/mcp/main.ts",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector@latest -- pnpm --silent mcp",
    "test": "LOG_LEVEL=silent vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "firebase-admin": "^14.5.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
